<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    Package visibility (Android 11+/API 30+) WITHOUT QUERY_ALL_PACKAGES — removed for Play review
    (a sensitive permission with a hard review bar). These scoped <queries> grant exactly the
    visibility the code needs:
      · MAIN/LAUNCHER  → getInstalledApps() enumerates every user-launchable app for the
        block-target picker. Apps with NO launcher activity (background-only / drawer-hidden)
        are excluded, but those aren't user-openable so they are never a distraction target.
      · MAIN/HOME, SETTINGS, DIAL → SystemEssentialApps.resolve() reads the default launcher /
        settings / dialer so allow-mode ("block everything except…") never shields them and bricks
        the phone. The launcher has no hardcoded floor, so its HOME intent MUST be declared here.
        (Dialer/IME also resolve via TelecomManager / Settings.Secure, which need no visibility.)
  -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.HOME" />
    </intent>
    <intent>
      <action android:name="android.settings.SETTINGS" />
    </intent>
    <intent>
      <action android:name="android.intent.action.DIAL" />
    </intent>
  </queries>
</manifest>
